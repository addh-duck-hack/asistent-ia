# Copia este archivo a backend/.env antes de "docker compose up -d --build".
# backend/.env está cubierto por .gitignore (*.env) y no entra en la imagen:
# se inyecta en runtime vía env_file, así que un cambio aquí se aplica con
# "docker compose up -d" (sin --build).

PORT=5000

# --- MongoDB ---
# Tu servidor Mongo existente. Usa una DB y un usuario dedicados, p. ej.:
# mongodb://asistent_ia:<password>@<host>:27017/asistent_ia?authSource=asistent_ia
MONGO_URL=

# --- Auth de la app Mac ---
# Token largo y aleatorio (mín. 32 caracteres). Generar con: openssl rand -hex 32
# La app Mac lo guarda en Keychain y lo manda como "Authorization: Bearer ...".
API_TOKEN=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Cifrado de tokens de integraciones (Teams/Notion) ---
# 32 bytes en hex. Generar con: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Microsoft Teams (Graph API, Fase 4) ---
# App registrada en Entra ID con permisos delegados Chat.Read,
# ChannelMessage.Read.All, User.Read, offline_access.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=

# --- Notion (Fase 4) ---
NOTION_TOKEN=

# URL pública del backend (sin slash final), servida por Nginx Proxy Manager.
BACKEND_PUBLIC_URL=https://asistant.duck-hack.cloud

# Tareas programadas (digest semanal). docker-compose.yml lo fuerza a "true"
# solo en el worker; déjalo en false aquí para que el API no las corra.
SCHEDULER_ENABLED=false
